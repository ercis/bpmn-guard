    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_2" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_8" targetRef="EndEvent_1" />
  </bpmn:process>

