    <bpmn:intermediateThrowEvent id="Event_2" name="Shipment created"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:intermediateThrowEvent>

    <bpmn:task id="Task_7" name="Send shipment"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_8" name="Issue invoice"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Order shipped"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
