  <bpmn:process id="Process_r2_valid_order_fulfillment_state_12" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Order received"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent>

    <bpmn:task id="Task_1" name="Validate order"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:task>
