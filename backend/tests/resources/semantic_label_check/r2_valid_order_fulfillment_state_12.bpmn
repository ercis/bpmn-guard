    <bpmn:task id="Task_3" name="Reserve stock"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_1" name="Stock reserved"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_4" name="Pick items"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
