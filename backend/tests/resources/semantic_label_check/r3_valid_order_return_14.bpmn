                  id="Definitions_r3_valid_order_return_14"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:process id="Process_r3_valid_order_return_14" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Return requested"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent>

    <bpmn:task id="Task_1" name="Register return"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_2" name="Check order"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_3" name="Check warranty"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_1" name="Is return eligible?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_4" name="Send return label"><bpmn:incoming>Flow_Yes</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_5" name="Notify customer"><bpmn:incoming>Flow_No</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_1" name="Items received"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_6" name="Inspect items"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_2" name="Is damage found?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Damaged</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ok</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_7" name="Reject refund"><bpmn:incoming>Flow_Damaged</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_8" name="Approve refund"><bpmn:incoming>Flow_Ok</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_9" name="Send refund"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Return rejected"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_2" name="Refund sent"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_3" name="Return declined"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_1" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_1" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="Event_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="EndEvent_3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_1" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_6" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_Damaged" name="Yes" sourceRef="Gateway_2" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_Ok" name="No" sourceRef="Gateway_2" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_7" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_8" targetRef="Task_9" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_9" targetRef="EndEvent_2" />
  </bpmn:process>

