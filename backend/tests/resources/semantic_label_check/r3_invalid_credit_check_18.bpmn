    <bpmn:sequenceFlow id="Flow_A" name="Continue" sourceRef="Gateway_1" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_B" name="Next" sourceRef="Gateway_1" targetRef="Task_8" />

    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="Task_6" />
