    <bpmn:task id="Task_7" name="Approve application"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>

    <bpmn:task id="Task_8" name="Reject application"><bpmn:incoming>Flow_B</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Application approved"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_2" name="Application rejected"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent>

