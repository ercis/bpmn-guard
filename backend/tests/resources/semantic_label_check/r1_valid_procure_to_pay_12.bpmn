    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_10" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_11" targetRef="Task_12" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_12" targetRef="EndEvent_1" />
  </bpmn:process>

