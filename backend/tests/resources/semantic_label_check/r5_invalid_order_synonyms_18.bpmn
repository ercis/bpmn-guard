<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_r5_invalid_order_synonyms_18"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.40.1">
  <bpmn:process id="Process_r5_invalid_order_synonyms_18" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Order received"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent>
    <!-- order vs purchase -->
    <bpmn:task id="Task_1" name="Register order"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_2" name="Check purchase"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_3" name="Check stock"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_1" name="Is stock available?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <!-- reserve vs allocate -->
    <bpmn:task id="Task_4" name="Allocate stock"><bpmn:incoming>Flow_Yes</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_5" name="Notify customer"><bpmn:incoming>Flow_No</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_1" name="Stock reserved"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:intermediateCatchEvent>
    <!-- pick vs collect, pack vs box -->
    <bpmn:task id="Task_6" name="Collect items"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_7" name="Box items"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
    <!-- ship vs dispatch -->
    <bpmn:task id="Task_8" name="Dispatch order"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_2" name="Order shipped"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:intermediateCatchEvent>
    <!-- invoice vs bill -->
    <bpmn:task id="Task_9" name="Create bill"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_10" name="Send invoice"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_3" name="Invoice received"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_11" name="Receive payment"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Payment received"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_1" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_1" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="Event_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_1" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_8" targetRef="Event_2" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_2" targetRef="Task_9" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_10" targetRef="Event_3" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Event_3" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_11" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_r5_invalid_order_synonyms_18" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
