# Base Project Settings
PROJECT_NAME = "BPMN Guard"
APP_VERSION = "0.1.0"
API_VERSION_STR = "/api/v1"

# Environment
ENVIRONMENT = "development"

# Logging settings
LOG_LEVEL = "INFO"

# Middleware
BACKEND_CORS_ORIGINS = ["http://localhost:8000", "http://localhost:3000"]
HTTP_METHODS = ["GET", "POST", "PUT", "DELETE"]

# Database settings (filled in automatically by docker-compose for the bundled Postgres)
ASYNC_DATABASE_URI = # example: "postgresql+asyncpg://testuser:testpw@localhost:8080/bpmn_guard"
SYNC_DATABASE_URI =  # example: "postgresql+psycopg://testuser:testpw@localhost:8080/bpmn_guard"

# Demo-mode auth (single fixed user, no real login).
# Set DEMO_MODE=False and provide a strong JWT_SECRET to re-enable JWT verification.
DEMO_MODE = True
# DEMO_USER_ID = "00000000-0000-0000-0000-000000000001"
# DEMO_USER_EMAIL = "demo@example.com"
# JWT_SECRET = "demo-mode-insecure-do-not-deploy"

# Local filesystem for uploaded BPMN files
LOCAL_STORAGE_DIR = "./uploads"

# LLM provider (required for the semantic, duplicate, and chat checks).
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, LiteLLM, vLLM, etc.).
OPENAI_API_KEY =
OPENAI_API_ENDPOINT = "https://api.openai.com/v1"
# Override the defaults below if your provider exposes different model names.
# OPENAI_MODEL_NAME = "gpt-4o-mini"
# OPENAI_EMBEDDINGS_MODEL = "text-embedding-3-small"

# BPMN Example Files (used to seed the duplicate-check vector store on first boot)
BPMN_EXAMPLES_DIR = "../bpmn_examples"
VECTOR_DB_INIT = True  # set to True once on first boot, then flip back to False

# LangSmith Observability (optional - app works without these)
LANGSMITH_TRACING = False
LANGSMITH_API_KEY =
LANGSMITH_PROJECT = "bpmn-guard"
